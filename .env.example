# Copy to .env.local for local dev. Never commit real values.

# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=https://www.yourgym.com
# GitHub Pages only: Formspree form ID (formspree.io). Leave empty on Vercel.
NEXT_PUBLIC_FORMSPREE_ID=

# Server-only (Vercel): lead storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only (Vercel): owner email via Resend
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=owner@yourgym.com
LEAD_FROM_EMAIL=Leads <onboarding@resend.dev>
